        "assert \"trend_direction\" not in features\n",
        "assert \"trend_pct\" not in features\n",
        "assert \"client_id\" not in features\n",
        "\n",
        "print(\"Outcome leakage check: PASSED\")\n",
        "print(\"Trend percentage leakage check: PASSED\")\n",
        "print(\"Client identifier feature check: PASSED\")"
