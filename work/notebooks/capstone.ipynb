        "features = [\n",
        "    \"days_since_last_update\",\n",
        "    \"impressions_90d\",\n",
        "    \"avg_position\",\n",
        "    \"ctr\"\n",
        "]\n",
        "\n",
        "model_df = df[\n",
        "    features +\n",
        "    [\"trend_direction\", \"client_id\", \"content_id\"]\n",
        "].dropna().copy()\n",
        "\n",
        "X = model_df[features]\n",
        "\n",
        "y = (\n",
        "    model_df[\"trend_direction\"] == \"down\"\n",
        ").astype(int)\n",
        "\n",
        "groups = model_df[\"client_id\"]\n",
        "\n",
        "print(\"Model rows:\", len(model_df))\n",
        "print(\"Declining observations:\", y.sum())\n",
        "print(\"Declining rate:\", round(y.mean() * 100, 2), \"%\")\n",
        "print(\"Unique clients:\", groups.nunique())"
